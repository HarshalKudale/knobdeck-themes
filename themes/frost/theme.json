  "presets": [
    "Ice",
    "Rose",
    "Smoke"
  ],
  "colors": {
    "glass-color": "rgba(255, 255, 255, 0.22)",
    "glass-hover-color": "rgba(255, 255, 255, 0.42)",
    "edge-color": "rgba(255, 255, 255, 0.45)",
    "icon-color": "#ffffff",
    "text-color": "#ffffff",
    "shadow-color": "rgba(20, 10, 40, 0.22)"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    }
  ]
