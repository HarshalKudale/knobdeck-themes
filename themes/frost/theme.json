  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "Frosted glass discs with a soft sheen. Looks best over a colourful wallpaper.",
  "engineVersion": 1,
  "maxMenuRadius": 180,
  "centerTextWrapWidth": 80,
