{
  "name": "Contrast",
  "author": "KnobDeck",
  "license": "CC0-1.0",
  "version": "1.0.0",
  "description": "Maximum legibility: bold outlines, large targets and labels, almost no motion.",
  "engineVersion": 1,
  "maxMenuRadius": 180,
  "centerTextWrapWidth": 88,
  "drawChildrenBelow": true,
  "drawCenterText": true,
  "drawSelectionWedges": true,
  "drawWedgeSeparators": false,
  "previewBackground": "#3a3a3a",
  "presets": [
    "Black on White",
    "White on Blue"
  ],
  "colors": {
    "back-color": "#000000",
    "fore-color": "#ffd400",
    "on-fore-color": "#000000",
    "ring-color": "#ffffff"
  },
  "layers": [
    {
      "class": "face",
      "content": "icon"
    }
  ]
}
